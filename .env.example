# Used by docker-compose.yml and the backend (backend reads .env in its working directory).
JWT_SECRET=change-me-to-a-long-random-string
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://flags_app:flags_app@localhost:5432/flags
MIGRATION_DATABASE_URL=postgresql+psycopg://flags_owner:flags_owner@localhost:5432/flags
